{{!
    @template tool_bass/preview

    What applying the requested settings would do to each selected activity: the
    settings that change (current and new value), the errors that stop an
    activity from being changed, and the warnings. Nothing has been
    written yet. The stale bar is shown by JS when the settings or the
    selection change after the preview.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="tool_bass-preview" - the preview wrapper
    * data-region="tool_bass-stale" - the stale-preview bar, inside an always-present live region
    * data-region="tool_bass-previewactivity" with data-cmid and data-status - one activity's preview

    Context variables required for this template:
    * summary string - how many activities change, do not change, cannot be changed (plain text)
    * canapply bool - whether any activity can be changed
    * needsconfirm bool - whether applying resets completion data (a confirmation is required)
    * activities array - one entry per selected activity, in course order
      * cmid int - the course module id
      * name string - the activity name, already formatted with format_string() (HTML)
      * url string|null - the activity's page
      * status string - change, nochange or error
      * statustext string - the status as text
      * iserror bool - whether the activity cannot be changed
      * ischange bool - whether the activity will change
      * hasrows bool - whether there are changed settings to list
      * rows array - the changed settings (plain text)
        * label string - the setting name
        * old string - the current value
        * new string - the new value
      * errors array - each with message (plain text): why the activity cannot be changed
      * warnings array - each with message (plain text)

    Example context (json):
    {
        "summary": "1 activity will change, 0 will not change, 1 cannot be changed.",
        "canapply": true,
        "needsconfirm": true,
        "activities": [
            {
                "cmid": 12,
                "name": "Week 1 quiz",
                "url": "https://example.com/mod/quiz/view.php?id=12",
                "status": "change",
                "statustext": "Will change",
                "iserror": false,
                "ischange": true,
                "hasrows": true,
                "rows": [
                    {"label": "Grade to pass", "old": "0", "new": "5"},
                    {"label": "Require the use of Safe Exam Browser", "old": "No", "new": "Yes - Use an existing template"}
                ],
                "errors": [],
                "warnings": [{"message": "Students have completion data for this activity."}]
            },
            {
                "cmid": 13,
                "name": "Week 2 quiz",
                "url": "https://example.com/mod/quiz/view.php?id=13",
                "status": "error",
                "statustext": "Cannot be changed",
                "iserror": true,
                "ischange": false,
                "hasrows": false,
                "rows": [],
                "errors": [{"message": "Grade to pass: The grade to pass can not be greater than the maximum possible grade 10"}],
                "warnings": []
            }
        ]
    }
}}
<div data-region="tool_bass-preview" class="tool_bass-preview">
    <div role="status">
        <div data-region="tool_bass-stale" class="alert alert-warning" hidden>{{#str}}previewstale, tool_bass{{/str}}</div>
    </div>
    <p class="fw-bold">{{summary}}</p>
    {{#activities}}
    <div class="card mb-3" data-region="tool_bass-previewactivity" data-cmid="{{cmid}}" data-status="{{status}}">
        <div class="card-header d-flex flex-wrap align-items-center">
            {{#url}}<a class="me-2 fw-bold" href="{{url}}">{{{name}}}</a>{{/url}}{{^url}}<span class="me-2 fw-bold">{{{name}}}</span>{{/url}}
            <span class="badge {{#iserror}}bg-danger{{/iserror}}{{#ischange}}bg-success{{/ischange}}{{^iserror}}{{^ischange}}bg-secondary{{/ischange}}{{/iserror}}">{{statustext}}</span>
        </div>
        <div class="card-body">
            {{#errors}}
            <div class="alert alert-danger mb-2">{{message}}</div>
            {{/errors}}
            {{#warnings}}
            <div class="alert alert-warning mb-2">{{message}}</div>
            {{/warnings}}
            {{#hasrows}}
            <table class="table table-sm generaltable mb-0">
                <thead>
                    <tr>
                        <th scope="col">{{#str}}previewsetting, tool_bass{{/str}}</th>
                        <th scope="col">{{#str}}previewold, tool_bass{{/str}}</th>
                        <th scope="col">{{#str}}previewnew, tool_bass{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                    <tr>
                        <th scope="row">{{label}}</th>
                        <td>{{old}}</td>
                        <td>{{new}}</td>
                    </tr>
                    {{/rows}}
                </tbody>
            </table>
            {{/hasrows}}
            {{^hasrows}}{{^iserror}}
            <p class="mb-0">{{#str}}previewnochange, tool_bass{{/str}}</p>
            {{/iserror}}{{/hasrows}}
        </div>
    </div>
    {{/activities}}
    {{#needsconfirm}}
    <div class="alert alert-warning">{{#str}}confirmneeded, tool_bass{{/str}}</div>
    {{/needsconfirm}}
    {{^canapply}}
    <div class="alert alert-info">{{#str}}nothingtoapply, tool_bass{{/str}}</div>
    {{/canapply}}
</div>
