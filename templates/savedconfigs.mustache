{{!
    @template tool_bass/savedconfigs

    The course's saved configurations of the chosen activity type (Load, Delete) and the
    site's admin presets of that type (Load). Loading only fills the settings form;
    nothing is written to any activity.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasconfigs bool - whether the course has any configuration
    * configs array - the course's configurations, sorted by name
      * name string - the configuration's name
      * timemodified string - when it was last saved, formatted
      * loadurl string - the URL that loads it into the form
      * deleteurl string - the URL that asks to delete it
    * haspresets bool - whether the site has any admin preset
    * presets array - the admin presets, sorted by name (name, timemodified, loadurl)

    Example context (json):
    {
        "hasconfigs": true,
        "configs": [
            {"name": "Exam review options", "timemodified": "3/10/26, 09:15", "loadurl": "#", "deleteurl": "#"}
        ],
        "haspresets": true,
        "presets": [
            {"name": "Department exam setup", "timemodified": "1/10/26, 12:00", "loadurl": "#"}
        ]
    }
}}
<div class="mb-3" data-region="tool_bass-savedconfigs">
    <h3 class="h5">{{#str}}savedconfigs, tool_bass{{/str}}</h3>
    {{#hasconfigs}}
        <table class="table table-sm generaltable w-auto">
            <thead>
                <tr>
                    <th scope="col">{{#str}}configname, tool_bass{{/str}}</th>
                    <th scope="col">{{#str}}configsavedon, tool_bass{{/str}}</th>
                    <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#configs}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{timemodified}}</td>
                        <td class="text-nowrap">
                            <a class="btn btn-secondary btn-sm" href="{{loadurl}}">
                                {{#str}}load, tool_bass{{/str}}<span class="visually-hidden"> {{name}}</span>
                            </a>
                            <a class="btn btn-outline-danger btn-sm ms-1" href="{{deleteurl}}">
                                {{#str}}delete{{/str}}<span class="visually-hidden"> {{name}}</span>
                            </a>
                        </td>
                    </tr>
                {{/configs}}
            </tbody>
        </table>
    {{/hasconfigs}}
    {{^hasconfigs}}
        <p class="text-muted">{{#str}}nosavedconfigs, tool_bass{{/str}}</p>
    {{/hasconfigs}}
    {{#haspresets}}
        <h3 class="h5">{{#str}}adminpresets, tool_bass{{/str}}</h3>
        <table class="table table-sm generaltable w-auto">
            <thead>
                <tr>
                    <th scope="col">{{#str}}presetname, tool_bass{{/str}}</th>
                    <th scope="col">{{#str}}configsavedon, tool_bass{{/str}}</th>
                    <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#presets}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{timemodified}}</td>
                        <td>
                            <a class="btn btn-secondary btn-sm" href="{{loadurl}}">
                                {{#str}}load, tool_bass{{/str}}<span class="visually-hidden"> {{name}}</span>
                            </a>
                        </td>
                    </tr>
                {{/presets}}
            </tbody>
        </table>
    {{/haspresets}}
</div>
